# Copia a .env y completa. No commitees .env real (está en .gitignore)
# Groq principal, DeepSeek fallback (mayor razonamiento)
OLLAMA_URL=https://api.groq.com/openai/v1
GROQ_API_KEY=sk_groq_xxx
GROQ_MODEL=llama-3.1-70b-versatile
# Opciones Groq: llama-3.1-70b-versatile | llama-3.1-8b-instant | qwen-2.5-32b | deepseek-r1-distill-llama-70b

# Plan B DeepSeek (si Groq 429 o quieres razonamiento profundo)
DEEPSEEK_API_KEY=sk_deepseek_xxx
DEEPSEEK_MODEL=deepseek-chat
# Para usar DeepSeek como principal cambia OLLAMA_URL a https://api.deepseek.com
# y deja GROQ_API_KEY vacío (server.py detecta por OLLAMA_URL)

# Puerto local (Vercel/Render sobreescriben con PORT)
PORT=8000
